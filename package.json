{
  "name": "vorvn-origins-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "preview:web": "vite preview --host 127.0.0.1",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "test:browser:smoke": "env -u NO_COLOR playwright test",
    "generate:api": ".venv/bin/python scripts/export_openapi.py && openapi-typescript openapi/origins-v1.json -o frontend/src/types/api.generated.ts",
    "check:typography": "node frontend/scripts/check-typography.mjs",
    "check": "pnpm check:typography && pnpm generate:api && pnpm build:web && pnpm test:web"
  },
  "dependencies": {
    "@dawcore/transport": "0.0.14",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-slot": "latest",
    "@waveform-playlist/core": "12.6.1",
    "@waveform-playlist/engine": "13.6.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "lucide-react": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "latest",
    "wavesurfer.js": "7.11.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "latest",
    "typescript": "5.9.3",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
