{
  "name": "vorvn-audio-studio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "preview:web": "vite preview --host 127.0.0.1",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "generate:api": ".venv/bin/python scripts/export_openapi.py && openapi-typescript openapi/audio-studio-v1.json -o frontend/src/types/api.generated.ts",
    "check": "pnpm generate:api && pnpm build:web && pnpm test:web"
  },
  "dependencies": {
    "@radix-ui/react-slot": "latest",
