# Copy this file to .env and paste your key in.
# Get one at: https://modelstudio.console.alibabacloud.com/  -> API-KEY
DASHSCOPE_API_KEY=

# Which Alibaba Cloud region your key belongs to.
#   intl    = Singapore / international console (most people outside China)
#   beijing = mainland China console
# A key from one region will NOT work against the other.
DASHSCOPE_REGION=intl

# Optional workspace-specific endpoint for Model Studio text operations.
DASHSCOPE_WORKSPACE_ID=

# Default voice, override per-run with --voice
QWEN_TTS_VOICE=longanlingxin

# Auvi Studio runtime. The defaults match docker-compose.yml.
DATABASE_URL=postgresql://voicestudio:voicestudio@127.0.0.1:5434/voicestudio
AUDIO_STUDIO_HOST=127.0.0.1
AUDIO_STUDIO_OUTPUT_DIR=

# KIE Director generation. The API key remains editable from Auvi Settings.
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai

# Optional production webhook. Leave both empty for local polling fallback.
# KIE_CALLBACK_URL=https://your-public-auvi-host/api/v1/providers/kie/callback
KIE_CALLBACK_URL=
KIE_WEBHOOK_HMAC_KEY=
